# ─────────────────────────────────────────────────────────────────────────────
# Shantaz Technofoods ERP — Environment Variables
#
# Copy this file to `.env` and fill in real values.
# DO NOT commit `.env` to git. `.env` is already in .gitignore.
#
# All Vite env vars MUST be prefixed with VITE_ to be exposed to the client.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED for live mode) ─────────────────────────────────────────
# These three together switch the app into live database mode. In production
# (Vercel) ALL THREE must be set in Project → Settings → Environment Variables,
# then you must REDEPLOY — Vite inlines env vars at BUILD time, so changing them
# without a rebuild has no effect.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx_or_anon_jwt
VITE_USE_SUPABASE=true

# ── Build / app metadata ─────────────────────────────────────────────────────
# Set VITE_APP_ENV=production for deployed builds — this strips debug logs and
# disables the in-browser debug helpers (window.__*).
VITE_APP_NAME=Shantaz Technofoods ERP
VITE_APP_ENV=production

# ── Demo / seed data ──────────────────────────────────────────────────────────
# OFF by default. Demo inventory/vendors/POs ONLY load when this is "true" AND
# Supabase is disabled (deliberate offline local dev). Never leave this on for a
# deployed or Supabase-backed build.
VITE_ALLOW_DEMO=false

# ── Module on/off ceiling + which deployment this is ─────────────────────────
# VITE_ENABLED_MODULES: comma list of module ids this deployment may switch on
# (src/utils/modules.js). ERP LIVE: machines,reports,settings,users,roles
# Leave EMPTY for the Trial ERP (no ceiling — every module available).
VITE_ENABLED_MODULES=
# VITE_ERP_INSTANCE: "trial" shows a small TRIAL ribbon so nobody enters real
# work in the Trial ERP. Leave EMPTY on ERP LIVE (no ribbon).
VITE_ERP_INSTANCE=

# ── Error reporting (Sentry) ─────────────────────────────────────────────────
# MIHIR TRIAL: leave VITE_SENTRY_DSN empty — with VITE_ERP_INSTANCE=trial the
# build uses the Trial project's DSN (src/shared/sentry.js). ERP LIVE stays OFF
# until the owner creates a separate Live Sentry project and sets its DSN here
# (Vercel env). Production builds with VITE_USE_SUPABASE=true only.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=live
# VITE_SENTRY_DISABLED=false
