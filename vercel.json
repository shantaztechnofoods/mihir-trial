{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "feat/**": false,
      "fix/**": false,
      "chore/**": false,
      "refactor/**": false,
      "docs/**": false,
      "perf/**": false,
      "test/**": false,
      "ci/**": false,
      "hotfix/**": false,
      "release/**": false,
      "worktree-*": false,
      "worktree-*/**": false,
      "agent-*": false,
      "agent-*/**": false,
      "feature/**": false,
      "audit/**": false,
      "db/**": false,
      "ui/**": false,
      "wip/**": false,
      "backup/**": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    }
  ]
}
